{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "homebox-mcp values",
  "description": "Strict: a typo in a values file should fail the render, not be silently ignored and leave you wondering why a setting had no effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "homebox",
    "service",
    "auth",
    "proxy"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "repository"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Empty means the chart's appVersion. Pin it to upgrade deliberately rather than whenever the chart is republished."
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "homebox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "existingSecret"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Base URL WITHOUT /api - the server appends /api/v1 itself.",
          "not": {
            "pattern": "/api/?$"
          }
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "description": "Required. The token is never a literal in values: it would end up in a values file, in git, and in `helm get values` output."
        },
        "existingSecretTokenKey": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$",
          "description": "Deadline for an ordinary request to HomeBox, body included. A Go duration such as 30s."
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "uploadPort"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "The Service port that reaches the proxy."
        },
        "uploadPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "The Service port that reaches the upload listener, past the proxy."
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerUrl",
        "resourceUrl"
      ],
      "properties": {
        "issuerUrl": {
          "type": "string",
          "minLength": 1,
          "description": "The issuer's own URL, exactly as it appears in a token's `iss`. https. The proxy validates tokens against it."
        },
        "resourceUrl": {
          "type": "string",
          "minLength": 1,
          "description": "This server's own EXTERNAL URL: the RFC 8707 resource indicator a client names, the `aud` the proxy requires, and the base of upload links. https, a path, no trailing slash. Must match this resource's id in the issuer's policy, byte for byte."
        },
        "scope": {
          "type": "string",
          "description": "Advertised in the PRM's scopes_supported and the 401 challenge's scope; never checked. Empty omits both."
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "deploymentAnnotations": {
      "type": "object",
      "description": "Annotations on the Deployment itself. Reloader reads them here, not on the pod template.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824,
          "description": "Largest file an upload link accepts, in bytes. Raise HomeBox's HBOX_WEB_MAX_UPLOAD_SIZE (MiB) with it."
        },
        "ttl": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$",
          "description": "How long a link stays valid, 1m to 24h."
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$",
          "description": "How long one whole upload may take, 10s to 6h."
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "description": "The sluis resource-proxy sidecar. No default version: image.tag and image.digest are required.",
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "description": "The release to run, no leading v. REQUIRED (checked at render time)."
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$",
              "description": "sha256:<64 hex>, the image index digest. REQUIRED (checked at render time)."
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824,
          "description": "Largest request body the proxy accepts (413 beyond it). The proxy's default is 4 MiB; data_base64 attachments need about 13.4 MB."
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "description": "NetworkPolicy peers admitted on the proxy and upload ports (the gateway). Required while enabled."
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "https": {
              "type": "array"
            },
            "dns": {
              "type": "array"
            },
            "homebox": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "type": "array"
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            }
          }
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    }
  }
}
